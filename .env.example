PORT=3000
HOST=127.0.0.1
DATA_DIR=./data

# Keep this on the server only. Never expose it in browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# mock is best for local testing. stripe creates Checkout Sessions when STRIPE_SECRET_KEY is set.
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_BASE_URL=http://localhost:3000

# Used by the Admin tab to grant quota or plans manually.
ADMIN_SECRET=change-this-admin-secret
