NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=/app/data

# Frontend is hosted by Cloudflare. Backend/API is hosted by Render, Railway, Fly.io, or a VPS.
FRONTEND_BASE_URL=https://educopilot.ccwu.cc
PUBLIC_BASE_URL=https://qinghaxinyu.ccwu.cc
ALLOWED_ORIGINS=https://educopilot.ccwu.cc,https://qinghaxinyu.ccwu.cc

# Server-side only. Do not put these in frontend code.
DEFAULT_AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING=disabled
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5

# Use real payments in production. Mock payments are disabled when NODE_ENV=production.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Optional fallback for manual offline payments. Leave false for automatic public checkout.
ALLOW_MANUAL_PAYMENT=false

# Change this to a long random value before deploying.
ADMIN_SECRET=replace-with-a-long-random-admin-secret
